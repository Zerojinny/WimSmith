[Main]
Title=WimSmith
Description=Back up a volume or a folder to a WIM image and restore it, using wimlib. Source: the latest GitHub release or a local folder.
Author=zerojinny
Level=5
Selected=True
Mandatory=False
Version=1.1.0.0
Date=2026-11-09

[Variables]
%ProgramFolder%="WimSmith"
%ProgramExe%="WimSmith.exe"
%SetupFile%="WimSmith-x64.zip"
%DownloadURL%=https://github.com/Zerojinny/WimSmith/releases/latest/download/WimSmith-x64.zip
%Homepage%=https://github.com/Zerojinny/WimSmith

[Process]
Echo,"Processing %ScriptTitle%..."

If,%cb_RunFromRam%,Equal,True,RunFromRam
Set,%Dest%,"%TargetPrograms%\%ProgramFolder%"
Set,%PEExe%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%"
DirMake,"%Dest%"

///////////////////////////////////////////////////////////////////////////////////
// WimSmith: from a local folder, or the latest GitHub release
If,%cmb_Source%,Equal,"Local folder",Begin
  If,%fb_LocalDir%,Equal,"",Halt,"WimSmith: choose the local folder that holds WimSmith.exe."
  If,Not,ExistFile,"%fb_LocalDir%\%ProgramExe%",Halt,"WimSmith: [%fb_LocalDir%\%ProgramExe%] was not found."
  Echo,"Copying WimSmith from [%fb_LocalDir%]..."
  FileCopy,"%fb_LocalDir%\%ProgramExe%","%Dest%"
  If,ExistDir,"%fb_LocalDir%\lang",DirCopy,"%fb_LocalDir%\lang","%Dest%"
  If,ExistFile,"%fb_LocalDir%\LICENSE",FileCopy,"%fb_LocalDir%\LICENSE","%Dest%"
  If,ExistFile,"%fb_LocalDir%\lib\libwim-15.dll",DirCopy,"%fb_LocalDir%\lib","%Dest%"
End
Else,Begin
  If,%cb_AlwaysDownload%,Equal,True,DirDeleteEx,"%ProgramsCache%\%ProgramFolder%"
  If,Not,ExistFile,"%ProgramsCache%\%ProgramFolder%\%SetupFile%",Run,%ScriptFile%,DownloadProgram
  DirDeleteEx,"%ProjectTemp%\%ProgramFolder%"
  Decompress,"%ProgramsCache%\%ProgramFolder%\%SetupFile%","%ProjectTemp%\%ProgramFolder%"
  If,Not,ExistFile,"%ProjectTemp%\%ProgramFolder%\%ProgramExe%",Halt,"WimSmith: [%SetupFile%] does not contain %ProgramExe%."
  FileCopy,"%ProjectTemp%\%ProgramFolder%\%ProgramExe%","%Dest%"
  If,ExistDir,"%ProjectTemp%\%ProgramFolder%\lang",DirCopy,"%ProjectTemp%\%ProgramFolder%\lang","%Dest%"
  If,ExistFile,"%ProjectTemp%\%ProgramFolder%\LICENSE",FileCopy,"%ProjectTemp%\%ProgramFolder%\LICENSE","%Dest%"
  DirDeleteEx,"%ProjectTemp%\%ProgramFolder%"
End

///////////////////////////////////////////////////////////////////////////////////
// wimlib: the PE often has no internet, so libwim-15.dll is put into lib\ now
// (unless the local folder already had it), with its license texts
If,Not,ExistFile,"%Dest%\lib\libwim-15.dll",Begin
  Set,%WimlibZip%,"wimlib-%txt_WimlibVersion%-windows-x86_64-bin.zip"
  If,Not,ExistFile,"%ProgramsCache%\%ProgramFolder%\%WimlibZip%",Run,%ScriptFile%,DownloadWimlib
  DirDeleteEx,"%ProjectTemp%\wimlib"
  Decompress,"%ProgramsCache%\%ProgramFolder%\%WimlibZip%","%ProjectTemp%\wimlib"
  If,Not,ExistFile,"%ProjectTemp%\wimlib\libwim-15.dll",Halt,"WimSmith: [%WimlibZip%] does not contain libwim-15.dll."
  DirMake,"%Dest%\lib"
  FileCopy,"%ProjectTemp%\wimlib\libwim-15.dll","%Dest%\lib\libwim-15.dll"
  FileCopy,"%ProjectTemp%\wimlib\COPYING.txt","%Dest%\lib\wimlib_COPYING.txt"
  FileCopy,"%ProjectTemp%\wimlib\COPYING.LGPL.txt","%Dest%\lib\wimlib_COPYING.LGPL.txt"
  FileCopy,"%ProjectTemp%\wimlib\COPYING.GPLv3.txt","%Dest%\lib\wimlib_COPYING.GPLv3.txt"
  FileCopy,"%ProjectTemp%\wimlib\COPYING.libdivsufsort-lite.txt","%Dest%\lib\wimlib_COPYING.libdivsufsort-lite.txt"
  FileCreateBlank,"%Dest%\lib\versions.ini"
  TXTAddLine,"%Dest%\lib\versions.ini","wimlib = %txt_WimlibVersion%",Append
  DirDeleteEx,"%ProjectTemp%\wimlib"
End

///////////////////////////////////////////////////////////////////////////////////
// The language of WimSmith and of its right-click menu: the one chosen, or with
// "PE language" the language of the PE source (%SourceLang%, e.g. ko-KR -> ko)
Set,%LangCode%,"en"
If,%cmb_Language%,Equal,"Korean [ko]",Set,%LangCode%,"ko"
If,%cmb_Language%,Equal,"PE language",Begin
  StrFormat,Left,"%SourceLang%",2,%SrcLang2%
  If,%SrcLang2%,Equal,"ko",Set,%LangCode%,"ko"
End
Echo,"WimSmith language: [%LangCode%] (PE source language: [%SourceLang%])"

///////////////////////////////////////////////////////////////////////////////////
// WimSmith.ini (next to the exe): language, theme, the tab a WIM file opens in
Echo,"Configuring %ScriptTitle%..."
Set,%Ini%,"%Dest%\WimSmith.ini"
FileCreateBlank,"%Ini%"
TXTAddLine,"%Ini%","language = %LangCode%",Append
If,%cmb_Theme%,Equal,"Light",TXTAddLine,"%Ini%","theme = light",Append
Else,TXTAddLine,"%Ini%","theme = dark",Append
Set,%OpenTab%,"browse"
If,%cmb_OpenTab%,Equal,"Info",Set,%OpenTab%,"info"
If,%cmb_OpenTab%,Equal,"Restore",Set,%OpenTab%,"restore"
If,%cmb_OpenTab%,Equal,"Add an image",Set,%OpenTab%,"append"
If,%cmb_OpenTab%,Equal,"Export",Set,%OpenTab%,"export"
If,%cmb_OpenTab%,Equal,"Split / Join",Set,%OpenTab%,"splitjoin"
TXTAddLine,"%Ini%","open_tab = %OpenTab%",Append

///////////////////////////////////////////////////////////////////////////////////
// Opening a file (WimSmith.exe <file>, --open <tab> <file>) came with WimSmith 1.1.
// Its lang\en.ini has st.menu_append from then on: without it (1.0) the file
// associations and the right-click menu are left out.
Set,%OpensFiles%,True
If,ExistFile,"%Dest%\lang\en.ini",Begin
  IniRead,"%Dest%\lang\en.ini","ui","st.menu_append",%Probe%,"Default="
  If,"%Probe%",Equal,"",Begin
    Set,%OpensFiles%,False
    Echo,"WimSmith: this version cannot open files (1.1 or later needed): no file associations and no right-click menu. Use a newer release or a local folder.",WARN
  End
End

///////////////////////////////////////////////////////////////////////////////////
// File associations (PhoenixAPI Associate: also set as the user's choice at startup)
If,%OpensFiles%,Equal,True,Begin
  If,%cb_AssocWim%,Equal,True,Associate,.wim,"%PEExe%"
  If,%cb_AssocEsd%,Equal,True,Associate,.esd,"%PEExe%"
  If,%cb_AssocSwm%,Equal,True,Associate,.swm,"%PEExe%"
End

// The file icons (icon resources 2 / 3 / 4 of WimSmith.exe) came with WimSmith 1.2,
// whose lang\en.ini has rs.drivers; Associate gives the icon of the exe, so
// DefaultIcon is set again here
Set,%FileIcons%,False
If,%OpensFiles%,Equal,True,Begin
  If,ExistFile,"%Dest%\lang\en.ini",Begin
    IniRead,"%Dest%\lang\en.ini","ui","rs.drivers",%Probe%,"Default="
    If,Not,"%Probe%",Equal,"",Set,%FileIcons%,True
  End
End
If,%FileIcons%,Equal,True,Begin
  RegLoadHives
  If,%cb_AssocWim%,Equal,True,Run,%ScriptFile%,SetFileIcon,wim,2
  If,%cb_AssocEsd%,Equal,True,Run,%ScriptFile%,SetFileIcon,esd,3
  If,%cb_AssocSwm%,Equal,True,Run,%ScriptFile%,SetFileIcon,swm,4
  RegUnloadHives
End

///////////////////////////////////////////////////////////////////////////////////
// Right-click menu "WimSmith >" of .wim / .esd / .swm (WimSmith.exe --open <tab> "%1"),
// in the language of WimSmith: the texts come from its lang\<code>.ini (the same
// ones WimSmith uses), English when that file is missing
If,%OpensFiles%-%cb_ContextMenu%,Equal,True-True,Begin
  Set,%LangIni%,"%Dest%\lang\%LangCode%.ini"
  If,Not,ExistFile,"%LangIni%",Begin
    Echo,"WimSmith: [%LangIni%] was not found, the right-click menu is in English.",WARN
    Set,%LangIni%,"%Dest%\lang\en.ini"
  End
  IniRead,"%LangIni%","ui","bk.tab_apply",%tRestore%,"Default=Restore (apply a WIM)"
  IniRead,"%LangIni%","ui","st.menu_append",%tAppend%,"Default=Add an image (backup)"
  IniRead,"%LangIni%","ui","ex.tab",%tExport%,"Default=Export"
  IniRead,"%LangIni%","ui","sj.tab",%tSplitJoin%,"Default=Split / Join"
  IniRead,"%LangIni%","ui","in.tab",%tInfo%,"Default=Info"
  IniRead,"%LangIni%","ui","br.tab",%tBrowse%,"Default=Browse"
  RegLoadHives
  // .wim: every item
  Run,%ScriptFile%,AddMenu,.wim
  Run,%ScriptFile%,AddMenuItem,.wim,1_restore,restore,"%tRestore%"
  Run,%ScriptFile%,AddMenuItem,.wim,2_append,append,"%tAppend%"
  Run,%ScriptFile%,AddMenuItem,.wim,3_export,export,"%tExport%"
  Run,%ScriptFile%,AddMenuItem,.wim,4_splitjoin,splitjoin,"%tSplitJoin%"
  Run,%ScriptFile%,AddMenuItem,.wim,5_info,info,"%tInfo%"
  Run,%ScriptFile%,AddMenuItem,.wim,6_browse,browse,"%tBrowse%"
  // .esd: no new image, no split (solid resources)
  Run,%ScriptFile%,AddMenu,.esd
  Run,%ScriptFile%,AddMenuItem,.esd,1_restore,restore,"%tRestore%"
  Run,%ScriptFile%,AddMenuItem,.esd,2_export,export,"%tExport%"
  Run,%ScriptFile%,AddMenuItem,.esd,3_info,info,"%tInfo%"
  Run,%ScriptFile%,AddMenuItem,.esd,4_browse,browse,"%tBrowse%"
  // .swm: no new image; join
  Run,%ScriptFile%,AddMenu,.swm
  Run,%ScriptFile%,AddMenuItem,.swm,1_restore,restore,"%tRestore%"
  Run,%ScriptFile%,AddMenuItem,.swm,2_export,export,"%tExport%"
  Run,%ScriptFile%,AddMenuItem,.swm,3_splitjoin,splitjoin,"%tSplitJoin%"
  Run,%ScriptFile%,AddMenuItem,.swm,4_info,info,"%tInfo%"
  Run,%ScriptFile%,AddMenuItem,.swm,5_browse,browse,"%tBrowse%"
  RegUnloadHives
End

///////////////////////////////////////////////////////////////////////////////////
// Shortcuts
If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,"%PEExe%","","%PEPrograms%\%ProgramFolder%"
If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"%PEExe%","","%PEPrograms%\%ProgramFolder%"
If,%cb_PinToTaskbar%,Equal,True,PinShortcut,Taskbar,Auto,"%PEExe%"
If,%cb_PinToStartMenu%,Equal,True,PinShortcut,StartMenu,Auto,"%PEExe%"

[#AddMenu#]
// ===============================================================================================================================
// Name...........: AddMenu
// Description....: The "WimSmith >" submenu of an extension (whatever program opens it).
// Syntax.........: Run,%ScriptFile%,AddMenu,<.ext>
// Remarks........: The hives must be loaded (RegLoadHives).
// ===============================================================================================================================
[AddMenu]
Set,%MenuKey%,"Tmp_Software\Classes\SystemFileAssociations\%^SIPARAM_1%\shell\WimSmith"
RegWrite,HKLM,REG_SZ,"%MenuKey%","MUIVerb","WimSmith"
RegWrite,HKLM,REG_SZ,"%MenuKey%","Icon","#$q%PEExe%#$q,0"
RegWrite,HKLM,REG_SZ,"%MenuKey%","SubCommands",""

[#SetFileIcon#]
// ===============================================================================================================================
// Name...........: SetFileIcon
// Description....: The icon of a file type associated by PhoenixAPI Associate (class <ext>file): icon resource <Id> of WimSmith.exe.
// Syntax.........: Run,%ScriptFile%,SetFileIcon,<ext without dot>,<Id>
// Remarks........: The hives must be loaded (RegLoadHives).
// ===============================================================================================================================
[SetFileIcon]
RegWrite,HKLM,REG_EXPAND_SZ,"Tmp_Software\Classes\%^SIPARAM_1%file\DefaultIcon","","#$q%PEExe%#$q,-%^SIPARAM_2%"

[#AddMenuItem#]
// ===============================================================================================================================
// Name...........: AddMenuItem
// Description....: One item of the "WimSmith >" submenu: WimSmith.exe --open <tab> "%1".
// Syntax.........: Run,%ScriptFile%,AddMenuItem,<.ext>,<KeyName>,<Tab>,<Text>
// Remarks........: The key names give the order (1_..., 2_...). The hives must be loaded (RegLoadHives).
// ===============================================================================================================================
[AddMenuItem]
Set,%ItemKey%,"Tmp_Software\Classes\SystemFileAssociations\%^SIPARAM_1%\shell\WimSmith\shell\%^SIPARAM_2%"
RegWrite,HKLM,REG_SZ,"%ItemKey%","MUIVerb","%^SIPARAM_4%"
RegWrite,HKLM,REG_SZ,"%ItemKey%\command","","#$q%PEExe%#$q --open %^SIPARAM_3% #$q#$p1#$q"

[#DownloadProgram#]
// ===============================================================================================================================
// Name...........: DownloadProgram
// Description....: Download the latest WimSmith release from GitHub.
// Syntax.........: Run,%ScriptFile%,DownloadProgram
// ===============================================================================================================================
[DownloadProgram]
Echo,"Downloading %ScriptTitle%..."
DirMake,"%ProgramsCache%\%ProgramFolder%"
WebGet,"%DownloadURL%","%ProgramsCache%\%ProgramFolder%\%SetupFile%",NOERR
If,Not,%^RET%,Equal,200,Halt,"Failed to download [%SetupFile%] from [%DownloadURL%]: the code returned was [%^RET%]."

[#DownloadWimlib#]
// ===============================================================================================================================
// Name...........: DownloadWimlib
// Description....: Download the Windows x64 binaries of wimlib (the version in the interface) from wimlib.net.
// Syntax.........: Run,%ScriptFile%,DownloadWimlib
// ===============================================================================================================================
[DownloadWimlib]
Set,%WimlibZip%,"wimlib-%txt_WimlibVersion%-windows-x86_64-bin.zip"
Echo,"Downloading wimlib %txt_WimlibVersion%..."
DirMake,"%ProgramsCache%\%ProgramFolder%"
WebGet,"https://wimlib.net/downloads/%WimlibZip%","%ProgramsCache%\%ProgramFolder%\%WimlibZip%",NOERR
If,Not,%^RET%,Equal,200,Halt,"Failed to download [%WimlibZip%] from wimlib.net: the code returned was [%^RET%]. Check the wimlib version on https://wimlib.net."

[#DownloadAll#]
// ===============================================================================================================================
// Name...........: DownloadAll
// Description....: Download WimSmith (GitHub) and wimlib now (the download button).
// ===============================================================================================================================
[DownloadAll]
Run,%ScriptFile%,DownloadProgram
Run,%ScriptFile%,DownloadWimlib

[#ClearDownloadCache#]
// ===============================================================================================================================
// Name...........: ClearDownloadCache
// Description....: Remove the downloaded WimSmith and wimlib zip files.
// ===============================================================================================================================
[ClearDownloadCache]
DirDeleteEx,"%ProgramsCache%\%ProgramFolder%"

[#BrowseLocalDir#]
// ===============================================================================================================================
// Name...........: BrowseLocalDir
// Description....: Explore the local WimSmith folder.
// ===============================================================================================================================
[BrowseLocalDir]
If,ExistDir,%fb_LocalDir%,ShellExecuteEx,Explore,%fb_LocalDir%
Else,Message,"The specified directory does not exist.",ERROR

[#SetDefaultOptions#]
// ===============================================================================================================================
// Name...........: SetDefaultOptions
// Description....: Sets script options to default values.
// ===============================================================================================================================
[SetDefaultOptions]
WriteInterface,Value,%ScriptFile%,Interface,cmb_Source,"GitHub (latest release)"
WriteInterface,Value,%ScriptFile%,Interface,fb_LocalDir,""
WriteInterface,Value,%ScriptFile%,Interface,cb_AlwaysDownload,False
WriteInterface,Value,%ScriptFile%,Interface,txt_WimlibVersion,"1.14.5"
WriteInterface,Value,%ScriptFile%,Interface,cb_RunFromRam,False
WriteInterface,Value,%ScriptFile%,Interface,cb_DesktopShc,True
WriteInterface,Value,%ScriptFile%,Interface,cb_StartMenuShc,True
WriteInterface,Value,%ScriptFile%,Interface,cb_PinToTaskbar,False
WriteInterface,Value,%ScriptFile%,Interface,cb_PinToStartMenu,False
WriteInterface,Value,%ScriptFile%,Interface,txt_StartMenuFolder,"Backup & Imaging"
WriteInterface,Value,%ScriptFile%,Interface,txt_ShortcutName,"WimSmith"
WriteInterface,Value,%ScriptFile%,Interface,cmb_Language,"PE language"
WriteInterface,Value,%ScriptFile%,Interface,cmb_Theme,"Dark"
WriteInterface,Value,%ScriptFile%,Interface,cmb_OpenTab,"Browse"
WriteInterface,Value,%ScriptFile%,Interface,cb_AssocWim,True
WriteInterface,Value,%ScriptFile%,Interface,cb_AssocEsd,True
WriteInterface,Value,%ScriptFile%,Interface,cb_AssocSwm,True
WriteInterface,Value,%ScriptFile%,Interface,cb_ContextMenu,True

[#ShowScriptInfo#]
// ===============================================================================================================================
// Name...........: ShowScriptInfo
// ===============================================================================================================================
[ShowScriptInfo]
Message,"WimSmith backs up a volume or a folder to a WIM image and restores it, using wimlib (x64 only).#$x#$xSource:#$x- GitHub (latest release): downloads WimSmith-x64.zip of the latest release and caches it.#$x- Local folder: a folder with WimSmith.exe (and lang\, lib\ when present).#$x#$xwimlib (libwim-15.dll and its license texts) is put into lib\ at build time, downloaded from wimlib.net in the version given when the source has no lib\.#$x#$xWimSmith: MIT License. wimlib: LGPL v2.1 or later / GPL v3 or later, a separate DLL under its own license."

