# ============================================================
#  WimSmith - files that must never be committed
# ============================================================

# build result (build.bat) and its object files
WimSmith.exe
obj/
# the exes built from the old sources in backup\
backup/**/*.exe

# settings of this PC (language, folder of the last backup)
WimSmith.ini

# third-party programs, downloaded by WimSmith.exe (wimlib)
lib/
# old place of the wimlib DLL (moved into lib\ at start)
pe_tools/
libwim-15.dll
